services:
  migration:
    image: postgres:17
    entrypoint:
      - sh
      - -c
      - "psql -h {{ db_host }} -p 6432 -U {{ db_user }} -d {{ db_name }} -f /migrations/V1__init.sql"
    environment:
      - "PGPASSWORD={{ db_password }}"
      - "PGSSLMODE=disable"
    volumes:
      - ./migrations:/migrations:ro

  app:
    image: "{{ app_image }}:{{ app_image_tag }}"
    restart: unless-stopped
    depends_on:
      migration:
        condition: service_completed_successfully
    environment:
      - "SPRING_DATASOURCE_URL={{ db_url }}"
      - "SPRING_DATASOURCE_USERNAME={{ db_user }}"
      - "SPRING_DATASOURCE_PASSWORD={{ db_password }}"
      - "STORAGE_S3_ENDPOINT={{ s3_endpoint }}"
      - "STORAGE_S3_ACCESSKEY={{ s3_access_key }}"
      - "STORAGE_S3_SECRETKEY={{ s3_secret_key }}"
      - "STORAGE_S3_BUCKET={{ s3_bucket_name }}"
      - "STORAGE_S3_REGION=ru-central1"
    ports:
      - "127.0.0.1:8080:8080"
      - "127.0.0.1:9090:9090"
    volumes:
      - ./data:/app/data
      - ./logs:/app/logs

  nginx:
    image: nginx:1.27-alpine
    restart: unless-stopped
    depends_on:
      - app
    ports:
      - "{{ app_port }}:80"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - nginx_cache:/var/cache/nginx

volumes:
  nginx_cache:


    

