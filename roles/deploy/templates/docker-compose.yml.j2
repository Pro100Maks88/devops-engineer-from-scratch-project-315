services:
  migration:
    image: postgres:17
    entrypoint:
      - sh
      - -c
      - "psql -h {{ deploy_db_host }} -p 6432 -U {{ deploy_db_user }} -d {{ deploy_db_name }} -f /migrations/V1__init.sql"
    environment:
      - "PGPASSWORD={{ deploy_db_password }}"
      - "PGSSLMODE=disable"
    volumes:
      - ./migrations:/migrations:ro

  app:
    image: "{{ deploy_app_image }}:{{ deploy_app_image_tag }}"
    restart: unless-stopped
    depends_on:
      migration:
        condition: service_completed_successfully
    environment:
      - "SPRING_DATASOURCE_URL={{ deploy_db_url }}"
      - "SPRING_DATASOURCE_USERNAME={{ deploy_db_user }}"
      - "SPRING_DATASOURCE_PASSWORD={{ deploy_db_password }}"
      - "STORAGE_S3_ENDPOINT={{ deploy_s3_endpoint }}"
      - "STORAGE_S3_ACCESSKEY={{ deploy_s3_access_key }}"
      - "STORAGE_S3_SECRETKEY={{ deploy_s3_secret_key }}"
      - "STORAGE_S3_BUCKET={{ deploy_s3_bucket_name }}"
      - "STORAGE_S3_REGION=ru-central1"
    ports:
      - "127.0.0.1:8080:8080"
      - "127.0.0.1:9090:9090"
    volumes:
      - ./data:/app/data
      - ./logs:/app/logs

  nginx:
    image: nginx:1.27-alpine
    restart: unless-stopped
    depends_on:
      - app
    ports:
      - "{{ deploy_app_port }}:80"
      - "443:443"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./certbot/www:/var/www/certbot:ro
      - /etc/letsencrypt:/etc/letsencrypt:ro
      - nginx_cache:/var/cache/nginx

volumes:
  nginx_cache: